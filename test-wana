# =============================================================================
# test_wana.sh - Test suite for the wana script
# Usage: ./test_wana.sh
# Expected to be run from the directory containing wana and the log files
# =============================================================================

PASS=0
FAIL=0

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# -----------------------------------------------------------------------------
# run_test DESCRIPTION EXPECTED_OUTPUT ACTUAL_COMMAND...
# Compares actual output to expected, prints result, updates counters
# -----------------------------------------------------------------------------
run_test() {
    local description="$1"
    local expected="$2"
    shift 2
    local actual
    actual=$("$@" 2>/dev/null)

    # Sort both sides so order doesn't affect list-* tests
    local expected_sorted actual_sorted
    expected_sorted=$(echo "$expected" | sort)
    actual_sorted=$(echo "$actual" | sort)

    if [ "$expected_sorted" = "$actual_sorted" ]; then
        echo -e "${GREEN}[OK]${NC}   $description"
        PASS=$((PASS + 1))
    else
        echo -e "${RED}[FAIL]${NC} $description"
        echo "  --- expected ---"
        echo "$expected" | sed 's/^/  /'
        echo "  --- got ---"
        echo "$actual" | sed 's/^/  /'
        FAIL=$((FAIL + 1))
    fi
}

# -----------------------------------------------------------------------------
# run_test_ordered DESCRIPTION EXPECTED_OUTPUT ACTUAL_COMMAND...
# Like run_test but does NOT sort — use for histograms where order matters
# -----------------------------------------------------------------------------
run_test_ordered() {
    local description="$1"
    local expected="$2"
    shift 2
    local actual
    actual=$("$@" 2>/dev/null)

    if [ "$actual" = "$expected" ]; then
        echo -e "${GREEN}[OK]${NC}   $description"
        PASS=$((PASS + 1))
    else
        echo -e "${RED}[FAIL]${NC} $description"
        echo "  --- expected ---"
        echo "$expected" | sed 's/^/  /'
        echo "  --- got ---"
        echo "$actual" | sed 's/^/  /'
        FAIL=$((FAIL + 1))
    fi
}


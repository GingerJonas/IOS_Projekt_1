#!/bin/bash 

main() {

    command_name=""
    filtr_name=""
    file_name="${@: -1}"

    log-checker "$@" || return 1
    
    # loop all arguments
    while [ $# -gt 0 ]; do
        # check the first argument and decide what to do
        case $1 in 
            "list-ip"|"list-hosts"|"list-uri"|"hist-ip"|"hist-load")
            # if find one of the command save it and break loop
            command_name="$1"
            shift
            break
            ;;
            *)

            break 
            ;;
        esac
    done

    # condition if no commands or filter are written
   if [[ $# -eq 0 ]]; then 

        find . -name "*log*" -print | xargs -0 cat
    
    else
    
        if [[ "$file_name" == *.gz ]]; then
            zcat "$@" | sort -u
        else 
            cat "$@" | sort -u
    
        fi
    fi

 

}

log-checker() {
    
    # Checks if the file exist
    if [[ ! -f "$file_name" ]]; then
        echo "Error, $file_name does not exist" ;
        return 1 
    # Checks if the file is not empty
    elif [[ ! -s "$file_name" ]]; then
        echo "Error, $file_name is empty";
        return 1 
    fi
    return 0
}

# apply command using saved command name
command-apply() {

    case "$command_name" in 
        "list-ip")
        
        list-ip "$@"
        ;;
        "list-hosts")

        list-hosts "$@"
        ;;
        "list-uri")

        list-uri "$@"
        ;;
        "hist-ip")

        hist-ip "$@"
        ;;
    esac
}

list-ip() {
    
    # Print list of the first column that contains IP addresses
    awk '{print $1}' "$@" | sort -u
}

list-hosts() {

    # Make list of IP address that are piped into loop
    awk '{print $1}' "$@" | while read ip; do
    # For each IP address is made DNS lookup
    host $ip | awk '{print $NF}' | sort -u
    done 

}

list-uri() {
    
    # filter all lines without HTTP/1.1 then prints list of uri-
    grep "HTTP/1.1" "$@" | awk '{print $7}' | sort -u

}

hist-ip() {

    # sort all IP addresses by the appearence 
    awk '{print $1}' "$@" | sort | uniq -c | sort -r -k1,1 |
    awk '{
    
        printf "%s (%d): ", $2, $1
    
        for(i = 0; i < $1; i++){
        
            printf "#"
        }

        printf "\n"
    }'

}


#!/bin/bash 

main() {

    #set variables
    command_name=""
    time_after=""
    time_before=""
    file_name="${@: -1}"
    
    # loop all arguments
    while [ $# -gt 0 ]; do
        # check the first argument and decide what to do
        case $1 in 
            "-a")

            time_after="$2"
            shift 2
            
            ;;
            "-b")
            
            time_before=$2
            shift 2
            
            ;;
            "list-ip"|"list-hosts"|"list-uri"|"hist-ip"|"hist-load")
            
            # if find one of the command save it and break loop
            command_name="$1"
            shift
            
            break
            ;;
            *)

            break 
            ;;
        esac
    done

    log-checker "$@" || return 1


    if [[ -n "$command_name" || -n "$time_after" || -n "$time_before" ]]; then 

        gzip -dc "$@" 2>/dev/null | date-filter "$time_after" "$time_before" | 
        if [[ -n "$command_name" ]]; then 
            command-apply "$@"
        else 
            cat "$@"
        fi  
    else 

        gzip -dc "$@" 2>/dev/null

    fi
}

log-checker() {
    
    for file_name in "$@"; do
        # Checks if the file exist
        if [[ ! -f "$file_name" ]]; then
            echo "Error, $file_name does not exist" >&2
            return 1 
        # Checks if the file is not empty
        elif [[ ! -s "$file_name" ]]; then
            echo "Error, $file_name is empty" >&2
            return 1 
        fi
    done
    return 0
}

date-filter() { 


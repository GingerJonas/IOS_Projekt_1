#!/bin/bash 

main() {

    #set variables
    command_name=""
    time_after=""
    time_before=""
    file_name="${@: -1}"

    log-checker "$@" || return 1
    
    # loop all arguments
    while [ $# -gt 0 ]; do
        # check the first argument and decide what to do
        case $1 in 
            "-a")

            time_after="$2"
            shift 2
            
            ;;
            "-b")
            
            time_before=$2
            shift 2
            
            ;;
            "list-ip"|"list-hosts"|"list-uri"|"hist-ip"|"hist-load")
            
            # if find one of the command save it and break loop
            command_name="$1"
            shift
            
            break
            ;;
            *)

            break 
            ;;
        esac
    done

    if [[ -n "$command_name" ]]; then 

        command-apply "$@"
    else 
        # condition if no commands or filter are written
        if [[ $# -eq 0 ]]; then 

                find . -name "*log*" -print0 | xargs -0 cat
            
            else
            
                if [[ "$file_name" == *.gz ]]; then
                    zcat "$@" | sort -u
                else 
                    cat "$@" | sort -u
            
                fi
            fi
    fi
 

}

log-checker() {
    
    # Checks if the file exist
    if [[ ! -f "$file_name" ]]; then
        echo "Error, $file_name does not exist" ;
        return 1 
    # Checks if the file is not empty
    elif [[ ! -s "$file_name" ]]; then
        echo "Error, $file_name is empty";
        return 1 
    fi
    return 0
}

date-filter() { 

    # delete all dashes and colon from the date after and before
    if [[ -n "$time_after" ]]; then
        formatted_after=${echo "$time_after", tr -d " - : "}
    fi
    
    if [[ -n "$time_before" ]]; then
        formatted_before=${echo "$time_before", tr -d " - : "}
    fi

    # BEGIN is making dictionary of numbers for each month
    # define varibles for time after and before  
    awk -v alimit="$formated_after" -v blimit="$formated_before" '
    BEGIN {
       
        m["Jan"]="01"; m["Feb"]="02"; m["Mar"]="03"; m["Apr"]="04"; m["May"]="05"; m["Jun"]="06";
        m["Jul"]="07"; m["Aug"]="08"; m["Sep"]="09"; m["Oct"]="10"; m["Nov"]="11"; m["Dec"]="12"
   
    }
    

    
    '



}

# apply command using saved command name
command-apply() {

    case "$command_name" in 
        "list-ip")
        
        list-ip "$@"
        ;;
        "list-hosts")

        list-hosts "$@"
        ;;
        "list-uri")

        list-uri "$@"
        ;;
        "hist-ip")

        hist-ip "$@"
        ;;
    esac
}

list-ip() {
    
    # Print list of the first column that contains IP addresses
    awk '{print $1}' "$@" | sort -u
}

list-hosts() {

    # Make list of IP address that are piped into loop
    awk '{print $1}' "$@" | while read ip; do
    # For each IP address is made DNS lookup
    host $ip | awk '{print $NF}' | sort -u
    done 

}

list-uri() {
    
    # filter all lines without HTTP/1.1 then prints list of uri-
    grep "HTTP/1.1" "$@" | awk '{print $7}' | sort -u

}

hist-ip() {

    # sort all IP addresses by the appearence 
    awk '{print $1}' "$@" | sort | uniq -c | sort -r -k1,1 |
    awk '{
    
        printf "%s (%d): ", $2, $1
    
        for(i = 0; i < $1; i++){
        
            printf "#"
        }

        printf "\n"
    }'

}


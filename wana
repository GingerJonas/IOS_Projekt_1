#!/bin/bash 

# set variables
first_arg=$1

main() {
    # check the first argument and decide what to do
    case $first_arg in 
        "list-ip")
        shift 1
        
        log_name=$1 
        
        list-ip    
        ;;
        "list-host")
        shift 1

        log_name=$1

        list-host

        ;;
    esac
    
}

file-checker() {

    if [[ ! -f "$log_name" ]]; then
        echo "Error, log does not exist" ;
        return 1 
    elif [[ ! -s "$log_name" ]]; then
        echo "Error, $log_name is empty";
        return 1 
    fi
    return 0
}

list-ip() {
    
    file-checker || return 1
    
    awk -F"- -" '{print $1}' "$log_name"
}

list-host() {

    file-checker || return 1
    
    awk -F"- -" '{print $1}' "$log_name" | while read ip; do
    host $ip | awk '{print $NF}'
    done 
}



main "$@"
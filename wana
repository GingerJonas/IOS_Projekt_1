#!/bin/bash 

# set variables
first_arg=$1

main() {

    log-checker

    if [ $# -gt 1 ]; then
        # check the first argument and decide what to do
        case $first_arg in 
            "list-ip")
            shift 1

            list-ip "$@"
            
            ;;
            "list-hosts") 
            shift 1

            list-hosts "$@"

            ;;

            "list-uri")
            shift 1
            
            list-uri "$@"

            ;;
            "hist-ip")
            shift 1

            hist-ip "$@"

            ;;
            "hist-load")
            shift 1 


            ;;    
        esac
    fi
    
}

log-checker() {

    # Checks if the file contains something
    if [[ ! -f "$@" ]]; then
        echo "Error, log does not exist" ;
        return 1 
    # Checks if the file is not empty
    elif [[ ! -s "$@" ]]; then
        echo "Error, $@ is empty";
        return 1 
    fi
    return 0
}

list-ip() {
    
    # Print list of the first column that contains IP addresses
    awk '{print $1}' "$@"
}

list-hosts() {

    # Make list of IP address that are piped into loop
    awk '{print $1}' "$@" | while read ip; do
    # For each IP address is made DNS lookup
    host $ip | awk '{print $NF}'
    done 

}

list-uri() {
    
    # filter all lines without HTTP/1.1 then prints list of uri-
    grep "HTTP/1.1" "$@" | awk '{print $7}' 

}

hist-ip() {

    # sort all IP addresses by the appearence 
    awk '{print $1}' "$@" | sort | uniq -c | sort -r -k1,1 |
    awk '{
    
        printf "%s (%d): ", $2, $1
    
        for(i = 0; i < $1; i++){
        
            printf "#"
        }

        printf "\n"
    }'

}

hist-load() {

    # first need to do time filter

}

main "$@"